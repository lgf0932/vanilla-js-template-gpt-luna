# 对外暴露端口
NOVA_PORT=8787
# named volume 名称
NOVA_VOLUME=nova_data
# local SQLite；切换 Turso 时改为 turso
DB_DRIVER=sqlite
SQLITE_PATH=/app/data/app.sqlite
# 首次启动可留空并在 UI 设置密码；生产也可以填预生成的 PBKDF2 哈希
AUTH_PASSWORD_HASH=
# 必填：AES-GCM 信封加密主密钥，请替换为随机值
ENCRYPTION_KEY=replace-with-a-random-secret
# DB_DRIVER=turso 时必填
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 使用 GHCR 镜像部署时填写，例如 ghcr.io/owner/repo:v1.0.0
NOVA_IMAGE=nova-modular-app:local
